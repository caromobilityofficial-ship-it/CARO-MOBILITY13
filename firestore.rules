rules_version = '2';
/* ═══════════════════════════════════════════════════════════════════════════
   CARO Mobility — Firestore 보안 규칙  (2026-10-04, 18차: 17차 + 고객 알림(notifications), 단말 데이터 직원 전용, 관리자 클레임)

   ★이번에 고친 것 3가지
     1) 단말 계정이 **하나로 박혀 있던 것** → 차량마다 자기 계정으로 (2대째부터 못 쓰던 문제)
     2) 로그인만 하면 **누구나 아무 차에나 시동차단 명령**을 넣을 수 있던 것 → 고객은 문열기·잠금·비상등·경적만
     3) 정지된 사용자가 **자기 정지를 스스로 풀 수 있던 것** → 해제는 관리자만

   ★고객 서비스가 멈추지 않도록 일부러 그대로 둔 것
     · 명령 생성을 '서버(issueCommand)만' 으로 완전히 잠그지 않았다.
       지금 고객앱은 SECURE_SERVER: false 라 브라우저에서 직접 명령을 만든다.
       여기서 잠그면 **고객이 차 문을 못 연다.**
       앱이 서버 모드로 배포된 뒤에 아래 [2단계] 주석대로 한 줄만 바꾸면 된다.

   배포:  Firebase 콘솔 → Firestore Database → 규칙 → 붙여넣기 → 게시
   ═══════════════════════════════════════════════════════════════════════════ */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ───────── 최고관리자(본인) 식별 ───────── */
    /* ★[18차] 최고관리자 = 이메일 하드코딩 또는 superAdmin 클레임(setAdminAccount 가 부여). 이메일 줄은 클레임이 전원에게 붙은 뒤 지운다 */
    function isAdmin() {
      return request.auth != null &&
             ( request.auth.token.email == 'caro.mobility.official@gmail.com' ||
               request.auth.token.get('superAdmin', false) == true );
    }


    /* ───────── ★수정 1 — 차량 단말(ESP32) 계정 식별 ─────────
       예전:  'device-caro001@caro.local' 하나로 고정
              → 차량이 2대가 되는 순간 두 번째 단말은 아무것도 못 쓴다.
              → 여러 대가 계정 하나를 같이 쓰면, 단말 하나를 뜯어 비밀번호를 꺼내는 순간
                 **전 차량의 문을 열 수 있다.**
       지금:  차량 문서 id 로 계정 이름을 만들어 대조한다.
              devices/CARO-001  ←  caro-001@device.caromobility.kr  만 쓸 수 있다
              devices/CARO-002  ←  caro-002@device.caromobility.kr  만 쓸 수 있다
              (단말 펌웨어 config.h 의 DEV_ID / DEV_EMAIL 과 같은 규칙)
       옛 계정(device-caro001@caro.local)도 당분간 같이 받아 준다 — 기존 단말이 멈추지 않게. */
    function isDevice(deviceId) {
      return request.auth != null &&
             ( request.auth.token.email == deviceId.lower() + '@device.caromobility.kr'
               || request.auth.token.email == 'device-caro001@caro.local' );   // ← 옛 단말 정리되면 이 줄 삭제
    }

    /* ───────── 직원 권한 (admin_accounts/{이메일} 의 perms 로 판단) ───────── */
    function acctRef() {
      return /databases/$(database)/documents/admin_accounts/$(request.auth.token.email.lower());
    }
    function isActiveAdmin() {
      return request.auth != null && exists(acctRef()) &&
             get(acctRef()).data.get('active', false) == true;
    }
    /* ★[15차] '운영(ops)' 권한 = 예약·차량·요금·공지 등 운영 관리 전체(control 은 제외).
       관제 계정 화면(admin-accounts.js)은 새 계정에 'control' 과 'ops' 두 권한만 저장하는데,
       규칙은 예전 이름(resv/cars/pricing/notices)만 봐서 ops 만 가진 직원이 화면에는 들어와도
       데이터가 거부되는 어긋남이 있었다. 이제 ops 를 가진 직원은 control 을 뺀 나머지 권한으로 인정한다. */
    function can(p) {
      return isAdmin() ||
        (isActiveAdmin() &&
          ( get(acctRef()).data.get('perms', {}).get(p, false) == true
            || (p != 'control' && get(acctRef()).data.get('perms', {}).get('ops', false) == true) ));
    }
    /* 관제(사람)인가 — 시동차단처럼 위험한 명령을 보낼 수 있는 사람 */
    function isStaff() { return isAdmin() || can('resv') || can('cars'); }
    /* ★[18차] 단말 데이터(위치·진단·명령)를 볼 수 있는 사람 = 직원(예약·차량·운영·관제) */
    function canSeeDevices() { return isStaff() || can('control'); }

    /* ★[13차 보안] 차량에 명령을 보낼 수 있는 직원 = 관리자 또는 '실시간 관제(control)' 권한자.
       예전엔 위 isStaff() 를 그대로 써서 두 가지가 어긋났다.
         (가) 예약·차량 담당(control 없음)이 개발자도구로 시동차단 명령을 보낼 수 있었다.
         (나) 관제 화면은 control 권한자만 들여보내는데 규칙은 control 을 몰라서,
              control 만 가진 직원은 화면에는 들어와도 명령이 거부됐다.
       ※ 이 규칙을 게시하기 전에 관제를 맡길 직원 계정에 '실시간 관제' 권한이 체크돼 있는지 확인할 것. */
    function canCommand() { return isAdmin() || can('control'); }

    /* 2단계 인증(MFA)으로 로그인했는가 — 콘솔에서 Authentication 2단계 인증을 켠 뒤에만 쓴다.
       아래 commands create 조건 끝에 있는 mfaOk() 주석을 풀면, 직원 명령은 2단계 인증 로그인만 통과한다. */
    function mfaOk() { return request.auth.token.firebase.sign_in_second_factor != null; }

    /* 차량 — 모두 읽기, [차량 또는 요금] 권한자 쓰기 */
    match /cars/{carId} {
      allow read: if true;
      allow write: if can('cars') || can('pricing');
    }

    /* 요금 설정 (성수기/주말 요금) — 모두 읽기, [요금] 권한자 쓰기 */
    match /settings/{docId} {
      allow read: if true;
      allow write: if can('pricing');
    }

    /* caro the black 차량 */
    match /bl_cars/{carId} {
      allow read: if true;
      allow write: if can('cars') || can('pricing');
    }

    /* 공지·이벤트 — 모두 읽기, [공지] 권한자 쓰기 */
    match /notices/{id} {
      allow read: if true;
      allow write: if can('notices');
    }

    /* 관리자 계정 — 최고관리자만 관리 / 직원 본인은 자기 권한만 읽기 */
    match /admin_accounts/{id} {
      allow read:  if isAdmin() ||
                      (request.auth != null && id == request.auth.token.email.lower());
      allow write: if isAdmin();
    }

    /* 예약 — 본인 것만 + [예약] 권한자/관리자는 전체 */
    /* ★[15차] 예약 조회 = 본인 예약 + 직원(예약 담당·실시간 관제)·관리자만.
       예전엔 로그인한 누구나 '모든 고객의 예약'(이름·전화번호·차량·시간)을 읽을 수 있었다.
       다른 사람의 예약 시간은 개인정보가 없는 availability 컬렉션으로 본다(서버가 만든다).
       쓰기: 예약은 결제 승인 서버 함수(confirmPayment)가 만든다. 고객은 만들 수 없고,
             자기 예약에는 '주행 전 사진'(photos·photosUploadedAt)만 올릴 수 있다(금액·시간·반납 조작 차단).
             삭제·직접 수정은 직원/관리자만. */
    match /reservations/{resId} {
      allow read: if request.auth != null &&
                     ( resource.data.userId == request.auth.uid || can('resv') || can('control') );
      allow create: if can('resv');
      allow update: if request.auth != null &&
                       ( can('resv') ||
                         ( resource.data.userId == request.auth.uid &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photos', 'photosUploadedAt', 'photoCount', 'photoStorage']) ) );   /* ★[18차] 사진 저장 방식·개수 */
      allow delete: if can('resv');
    }

    /* 사용자 프로필 — ★[16차] 조회 = 본인 + 직원(예약 담당·실시간 관제)·관리자만.
       예전엔 로그인한 누구나 '모든 회원'의 이름·전화번호·생년월일·면허번호·카드 뒷자리를 읽을 수 있었다.
       고객앱은 자기 문서(users/내uid)만 읽고 쓰므로 그대로 동작한다. 관리자 화면은 이 컬렉션을 직접 읽지 않는다.
       (쓰기는 예전과 같음: 본인 또는 최고관리자) */
    match /users/{uid} {
      allow read: if request.auth != null &&
                     ( request.auth.uid == uid || can('resv') || can('control') );
      /* ★[17차] 본인은 '인증 결과' 항목(phoneVerified·certCI·certDI·verifiedAt)을 쓸 수 없다 — 예전엔 본인인증을 안 하고도 인증됨으로 꾸밀 수 있었다 */
      allow create: if request.auth != null &&
                       ( isAdmin() || ( request.auth.uid == uid &&
                         !request.resource.data.keys().hasAny(['phoneVerified','certCI','certDI','verifiedAt']) ) );
      allow update: if request.auth != null &&
                       ( isAdmin() || ( request.auth.uid == uid &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['phoneVerified','certCI','certDI','verifiedAt']) ) );
      allow delete: if isAdmin();
    }

    /* 로그인 이벤트 — ★[16차] 기록은 본인 것만 남길 수 있고(남의 uid 로 위조 불가), 조회는 관리자·예약 담당 직원만.
       예전엔 로그인한 누구나 전체 로그인 기록(이메일·기기 정보)을 읽고, 아무 내용이나 만들 수 있었다. */
    match /login_events/{eid} {
      allow read: if isAdmin() || can('resv');
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    /* AI 상담 기록 — 본인 작성/조회, 관리자는 전체(통계) */
    match /support_chats/{id} {
      allow read:   if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    /* 사고 접수 — 고객 본인 생성·조회 / 관리자·[예약] 직원 전체. 삭제 불가(보험·분쟁 대응) */
    match /accident_reports/{id} {
      allow read:   if isAdmin() || can('resv') ||
                       (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || can('resv');
      allow delete: if false;
    }

    /* 1:1 문의 */
    match /support_inquiries/{id} {
      allow read:   if isAdmin() || can('resv') ||
                       (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || can('resv');
      allow delete: if isAdmin();
    }

    /* ───────── 미납(채권) ───────── */
    /* ★[17차] 미납은 서버(반납 정산)와 직원만 만들고 바꾼다. 본인은 '보기'만.
       예전엔 본인이 자기 미납 문서를 고쳐 쓸 수 있어서 결제 없이 '납부됨'으로 바꾸거나 금액을 0 으로 만들 수 있었다.
       납부는 반드시 토스 결제(confirmPayment)를 거친다. */
    match /unpaid_debts/{docId} {
      allow read, write: if isAdmin() || can('resv');
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    /* ───────── ★수정 3 — 이용 정지 (문서 ID = 사용자 uid) ─────────
       예전:  본인이 자기 정지 문서를 통째로 쓸 수 있었다
              → 정지당한 사람이 active:false 로 바꿔 **스스로 정지를 풀 수 있었다.**
       지금:  본인은 '정지 걸기'(active:true)만 가능. 푸는 것은 관리자·[예약] 직원만.
              (고객앱 customer-redesign.js 가 장기 미납 시 스스로 기록하는 흐름은 그대로 동작) */
    /* ★[17차] 정지는 직원·서버만 건다. 본인 쓰기 전면 차단 —
       예전 '본인은 active:true 로만' 규칙은 untilTs(해제 시각)를 과거로 적어 스스로 푸는 우회가 가능했다. */
    match /suspensions/{uid} {
      allow read:  if isAdmin() || can('resv') || can('control') ||
                      (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin() || can('resv');
    }

    /* ═══════════ 차량 단말 (ESP32) ═══════════ */
    /* ★[18차] devices 읽기 = 직원·그 단말만. 예전엔 로그인한 고객 누구나 전 차량의 실시간 위치·배터리·진단을 읽을 수 있었다.
       고객앱은 서버 함수 myDeviceStatus 로 '내 예약 차량'의 온라인·연료만 받는다. */
    match /devices/{deviceId} {
      allow read:  if canSeeDevices() || isDevice(deviceId);
      /* 상태 보고는 그 차량의 단말 계정만. 다른 차 문서에는 손댈 수 없다. */
      allow write: if isAdmin() || isDevice(deviceId);

      /* 주행 기록 · 사건 기록 — 단말만 쓴다 (관제·고객앱은 읽기만 한다).
         예전엔 로그인한 사람이면 누구나 가짜 기록을 넣을 수 있었다. */
      match /telemetry/{tsId} {
        allow read:  if canSeeDevices();
        allow create: if isDevice(deviceId) || isAdmin();
        allow update, delete: if isAdmin();          /* 기록은 고쳐 쓰지 않는다 */
      }
      match /events/{eventId} {
        allow read:  if canSeeDevices();
        allow create: if isDevice(deviceId) || isAdmin();
        allow update, delete: if isAdmin();
      }

      /* ───────── ★수정 2 — 차량 명령 ─────────
         예전:  allow create: if request.auth != null;
                → 로그인한 사람이면 **누구나 아무 차에나** 명령을 만들 수 있었다.
                  개발자도구로 type:'immobilize' 를 넣으면 남의 차 시동을 끊을 수 있었다.
         지금:  · 관제(관리자·[예약]/[차량] 권한 직원) — 모든 명령
                · 그 밖의 로그인 사용자(고객앱) — 문열기·잠금·비상등·경적·차찾기 **만**
                  (시동차단·차단해제·재부팅·입력극성·층보정 등은 막힌다)
                · status 는 반드시 'pending' 으로 시작해야 한다
         ★[2단계] 앱이 서버 모드(SECURE_SERVER:true)로 배포되고 안정된 뒤에는
                  아래 create 조건을 `if canCommand();` 한 줄로 바꾼다.
                  그러면 고객 명령은 전부 서버(issueCommand)가 예약을 확인한 뒤에만 만들어진다.
                  ※ 지금 바꾸면 고객이 차 문을 못 연다. 반드시 앱 배포 뒤에. */
      match /commands/{cmdId} {
        /* ★[18차] 고객은 '자기가 보낸 명령' 문서만 읽는다(결과 확인용). 목록 조회는 직원만 */
        allow read:   if canSeeDevices() || isDevice(deviceId) ||
                         (request.auth != null && resource.data.issuedBy == request.auth.uid);
        /* ★3단계(이 파일) — 명령은 **서버 함수만** 만든다.
           고객 문열기·잠금  → issueCommand   (내 유효 예약·정지 여부를 서버가 확인)
           관제(직원) 명령   → staffCommand   (관제 권한·2단계 인증·값 형식을 서버가 확인, 기록 남김)
           서버는 Admin SDK 라 이 규칙을 통과하지 않고 쓴다. 브라우저에서 직접 쓰는 것은 전부 막힌다.
           ★게시 조건(순서 엄수): ①함수 배포(firebase deploy --only functions)  ②안드로이드 앱 재빌드·배포
                                   ③관제 화면 14차 업로드  ④그 뒤에 이 규칙 게시.  앞을 안 하고 게시하면 고객이 문을 못 연다. */
        allow create: if false;
        /* 실행 결과는 그 차량의 단말만 적는다 — 사람이 '실행된 척' 못 하게 */
        allow update: if isDevice(deviceId) || isAdmin();
        allow delete: if isAdmin();
      }
    }

    /* ───────── 서버(Cloud Functions)가 Admin SDK 로 쓰는 것들 ─────────
       Admin SDK 는 규칙을 우회하므로 쓰기는 false 로 두고, 화면에 필요한 읽기만 연다.
       (SECURE_SERVER 를 켰을 때 화면이 비지 않도록 미리 넣어 둔다) */
    match /availability/{id}  { allow read: if request.auth != null; allow write: if false; }
    match /orders/{orderId}   { allow read: if isAdmin() || can('resv') ||
                                             (request.auth != null && resource.data.uid == request.auth.uid);
                                allow write: if false; }
    match /command_log/{id}   { allow read: if isStaff() || can('control'); allow write: if false; }
    /* ★[17차] 관제(control) 직원도 알림을 보고 '읽음' 처리할 수 있다 (반납 지연·단말 오프라인 알림은 관제가 본다) */
    match /admin_alerts/{id}  { allow read, write: if isStaff() || can('control'); }
    /* ★[18차] 고객 알림 — 서버만 만든다. 본인은 읽기 + '읽음' 표시만 */
    match /notifications/{uid}/items/{id} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt']);
      allow create, delete: if false;
    }
    /* ★[17차] 쿠폰 사용 기록 — 서버만 쓴다. 본인은 자기 것만 조회 */
    match /coupon_uses/{id}   { allow read: if isAdmin() || can('resv') || (request.auth != null && resource.data.uid == request.auth.uid);
                                allow write: if false; }
    match /fuel_claims/{id}   { allow read: if isAdmin() || can('resv') ||
                                             (request.auth != null && resource.data.userId == request.auth.uid);
                                allow create: if request.auth != null &&
                                              request.resource.data.userId == request.auth.uid;
                                allow update, delete: if isAdmin() || can('resv'); }

    /* ───────── 그 외 전부 차단 ───────── */
    match /{document=**} { allow read, write: if false; }
  }
}
